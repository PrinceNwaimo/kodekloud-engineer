SOLUTION
Since both the IAM user and policy are already defined as resources in your main.tf, you just need to add the aws_iam_user_policy_attachment resource that references them directly.

📄 Updated /home/bob/terraform/main.tf
hcl
# Create IAM user
resource "aws_iam_user" "user" {
  name = "iamuser_kareem_t2q3"

  tags = {
    Name = "iamuser_kareem_t2q3"
  }
}

# Create IAM Policy
resource "aws_iam_policy" "policy" {
  name        = "iampolicy_kareem_t2q3"
  description = "IAM policy allowing EC2 read actions for kareem"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["ec2:Read*"]
        Resource = "*"
      }
    ]
  })
}

# Attach the IAM policy to the IAM user
