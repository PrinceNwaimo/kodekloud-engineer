        Resource = "*"
      }
    ]
  })
} main.tf
Since both the IAM user and the IAM policy are already defined as resources in your main.tf, you should reference them directly instead of using data sources. You just need to add the aws_iam_user_policy_attachment resource.

Here is your updated /home/bob/terraform/main.tf:

hcl
# Create IAM user
resource "aws_iam_user" "user" {
  name = "iamuser_kirsty"

  tags = {
    Name = "iamuser_kirsty"
  }
}

# Create IAM Policy
resource "aws_iam_policy" "policy" {
  name        = "iampolicy_kirsty"
  description = "IAM policy allowing EC2 read actions for kirsty"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["ec2:Read*"]
        Resource = "*"
      }
    ]
  })
}

# Attach the policy to the user
resource "aws_iam_user_policy_attachment" "kirsty_attach" {
  user       = aws_iam_user.user.name
  policy_arn = aws_iam_policy.policy.arn
}
💡 Key Details
Direct References: aws_iam_user.user.name and aws_iam_policy.policy.arn refer to the resources already defined in your file, creating a clean dependency chain.

Attachment Resource: aws_iam_user_policy_attachment is the correct resource for attaching a managed policy to a single user. It avoids the exclusive-attachment warning that comes with aws_iam_policy_attachment.

No Data Sources Needed: Since both resources are Terraform-managed in the same configuration, data lookups would be redundant.

🚀 Execution Steps
bash
cd /home/bob/terraform
terraform init
terraform plan
terraform apply --auto-approve
✅ Verify (optional)
bash
aws --endpoint-url=http://aws:4566 iam list-attached-user-policies --user-name iamuser_kirsty
You should see iampolicy_kirsty listed in the attached policies for the user.

