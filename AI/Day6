Step 3: Create email_assistant.py
python
import os
from openai import OpenAI

# Read API key and base URL from environment variables
api_key = os.environ.get('OPENAI_API_KEY')
base_url = os.environ.get('OPENAI_API_BASE')

# Create OpenAI client
client = OpenAI(api_key=api_key, base_url=base_url)


def rewrite_email(text: str) -> str:
    """Constructs a parameterized prompt to rewrite an email politely and professionally."""
    prompt = (
        f"Rewrite the following email text politely and professionally, "
        f"keeping the original intent but using courteous language:\n\n"
        f"\"{text}\""
    )
    return prompt


# Email text to rewrite
email_text = "hey send me that report asap"

# Build the prompt
prompt = rewrite_email(email_text)

# Send the prompt to the chat model
response = client.chat.completions.create(
    model="gpt-5.6-luna",
    messages=[{"role": "user", "content": prompt}],
    max_tokens=60,
    temperature=0.1,
)

# Print the polite rewritten email
print(response.choices[0].message.content)
