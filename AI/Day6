If credentials aren't in env vars
If /root/.bash_profile doesn't export them (e.g., just assigns OPENAI_API_KEY=sk-... without export), you can either add export to those lines or read the file in the script:

python
# Alternative: read directly from .bash_profile
def load_creds(path="/root/.bash_profile"):
    creds = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line.startswith("export "):
                line = line[len("export "):]
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                creds[k.strip()] = v.strip().strip('"').strip("'")
    return creds

creds = load_creds()
api_key = os.environ.get('OPENAI_API_KEY') or creds.get('OPENAI_API_KEY')
base_url = os.environ.get('OPENAI_API_BASE') or creds.get('OPENAI_API_BASE')
