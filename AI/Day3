# /root/openaiproject/commenter.py
import os
from openai import OpenAI

# Initialize the client using credentials from /root/.bash_profile
client = OpenAI(
    api_key=os.environ.get("OPENAI_API_KEY"),
    base_url=os.environ.get("OPENAI_API_BASE")
)


def generate_comment(code_snippet: str) -> str:
    """
    Uses the OpenAI chat model to generate a one-line comment
    explaining the purpose of the provided code snippet.
    """
    prompt = (
        "You are an expert Python developer. Analyze the following code snippet "
        "and generate a single, clear, one-line Python comment (or docstring) "
        "that accurately describes its purpose. "
        "Only return the comment itself, with no additional explanation.\n\n"
        f"Code snippet:\n{code_snippet}"
    )

    response = client.chat.completions.create(
        model="gpt-5.6-luna",
        messages=[
            {"role": "user", "content": prompt}
        ],
        max_tokens=50,
        temperature=0.2
    )

    comment = response.choices[0].message.content.strip()
    print(comment)
    return comment


# Test snippet
test_snippet = """def calculate_area(length, width):
    return length * width"""

if __name__ == "__main__":
    generate_comment(test_snippet)
