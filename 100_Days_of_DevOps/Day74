Final Jenkins script

Replace your Jenkins Execute Shell with:

#!/bin/bash

TODAY=$(date +%F)
FILE=db_${TODAY}.sql

echo "Creating database backup on stapp01..."

ssh -o StrictHostKeyChecking=no tony@stapp01 \
"mysqldump -u kodekloud_roy -pasdfgdsd kodekloud_db01 > /tmp/${FILE}"

echo "Copying backup from stapp01 to Jenkins..."

scp -o StrictHostKeyChecking=no \
tony@stapp01:/tmp/${FILE} /tmp/

echo "Copying backup to storage server..."

scp -o StrictHostKeyChecking=no \
/tmp/${FILE} natasha@ststor01:/home/natasha/db_backups/

echo "Cleaning temporary files..."

ssh -o StrictHostKeyChecking=no tony@stapp01 \
"rm -f /tmp/${FILE}"

rm -f /tmp/${FILE}

echo "Database backup completed successfully"

