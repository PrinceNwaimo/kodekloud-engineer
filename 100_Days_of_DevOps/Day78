18. Use this Jenkins pipeline

Paste the following:

pipeline {
    agent {
        label 'stapp01'
    }

    stages {
        stage('Deploy') {
            steps {
                script {
                    if (params.BRANCH == 'master') {
                        sh '''
                            cd /var/www/html
                            git fetch origin
                            git checkout master
                            git reset --hard origin/master
                        '''
                    } else if (params.BRANCH == 'feature') {
                        sh '''
                            cd /var/www/html
                            git fetch origin
                            git checkout feature
                            git reset --hard origin/feature
                        '''
                    } else {
                        error "Invalid BRANCH value: ${params.BRANCH}. Use master or feature."
                    }
                }
            }
        }
    }
}
